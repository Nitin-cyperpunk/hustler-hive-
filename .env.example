# Hustlers Hive — Environment Variables
# Copy this file to .env.local and fill in the values.

# Supabase — project URL and publishable (anon) key
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Server-only — NEVER prefix with NEXT_PUBLIC_
# Get from: https://supabase.com/dashboard/project/_/settings/api (service_role key)
SUPABASE_SERVICE_ROLE_KEY=

# App URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Community links
NEXT_PUBLIC_WHATSAPP_INVITE_URL=
